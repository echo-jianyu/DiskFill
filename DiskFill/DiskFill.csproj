<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>DiskFill</RootNamespace>
    <AssemblyName>DiskFill</AssemblyName>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>Assets\DiskFill.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <Company>DiskFill contributors</Company>
    <Product>DiskFill</Product>
    <Title>DiskFill 机械硬盘覆写工具</Title>
    <AssemblyTitle>DiskFill 机械硬盘覆写工具</AssemblyTitle>
    <Description>机械硬盘安全覆写与空间填充工具</Description>
    <Copyright>Copyright (c) DiskFill contributors</Copyright>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
